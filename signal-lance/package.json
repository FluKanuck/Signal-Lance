{
  "name": "signal-lance",
  "version": "1.0.0",
  "description": "Signal Lance: phone-first mech sensor/ECM prototype",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/pages.mjs",
    "check": "tsc --noEmit -p .",
    "sim": "node --experimental-strip-types --no-warnings scripts/sim.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:toy": "vite build --config vite.toy.config.ts && node scripts/toy-post.mjs",
    "lab": "vite --open /lab.html",
    "build:lab": "vite build -c vite.lab.config.ts"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@types/three": "^0.186.0",
    "three": "^0.186.1"
  }
}
